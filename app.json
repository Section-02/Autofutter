{
  "expo": {
    "name": "Personal Nutrition Tracker",
    "slug": "personal-nutrition-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "personalnutritiontracker",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.personalnutritiontracker.app",
      "supportsTablet": false,
      "usesIcloudStorage": true,
      "infoPlist": {
        "NSUbiquitousContainers": {
          "iCloud.com.personalnutritiontracker.app": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Personal Nutrition Tracker",
            "NSUbiquitousContainerSupportedFolderLevels": "ANY"
          }
        }
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.personalnutritiontracker.app"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.personalnutritiontracker.app"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)com.personalnutritiontracker.app"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B2A86"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
